LOCAL_DB=true
MONGODB_URI=mongodb://127.0.0.1:27017
PREDICT_SERVER_URL=http://127.0.0.1:8000
# 排名数据源地址；未配置时使用内置的 GarupaSpeedTracker 地址
RANKING_API_BASE_URL=https://grp-speed-backend.starfreedomx.top
# 本地 GarupaSpeedTracker 数据源地址；启动时探测一次，可达则插入排名回退链最前（star_viewer 之前，仅国服/月榜链路生效）
# 设为空字符串可禁用；默认 http://127.0.0.1:5519
# LOCAL_RANKING_API_URL=http://127.0.0.1:5519
MONGODB_DATABASE_NAME=tsugu-bangdream-bot
ARTICLE=true
MEMORY_CACHE=true
MEMORY_MONITOR=true
# 内存监控采样周期，最低 5000ms
MEMORY_MONITOR_INTERVAL_MS=600000
# 默认不记录完整请求体，避免大对象日志产生额外内存峰值
DEBUG_REQUEST_BODY=false
USE_BANDORISTATION=true
BACKEND_PORT=3000
# 压缩模式下图片输出的 JPEG 质量（0.1~1，数值越高越清晰、体积越大），默认 0.75
IMAGE_COMPRESS_QUALITY=0.75
BANGDREAM_OPTIMIZE_BASE_URL=http://127.0.0.1:3100
# 直接配置完整远程计算接口也可以：
# BANGDREAM_OPTIMIZE_CALC_URL=http://127.0.0.1:3100/v1/calc-result
# BANGDREAM_OPTIMIZE_MICRO_URL=http://127.0.0.1:3100/v1/micro-optimize
